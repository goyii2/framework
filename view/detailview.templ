package view

// detailView renders the attribute table of one model instance: one label
// cell and one value cell per row.
templ detailView(cells []detailCell) {
	<table class="table table-striped table-bordered detail-view">
		for _, cell := range cells {
			<tr>
				<th>{ cell.label }</th>
				<td>
					if cell.component != nil {
						@cell.component
					} else {
						{ cell.text }
					}
				</td>
			</tr>
		}
	</table>
}
