// The templ components of the backend partition: the dark frame the
// module's Layout mounts, the dashboard page and the post management pages
// (listing, compose/edit form). Dark is the point — the backend must be
// told apart from the frontend's light shell at a glance. (The templ
// package needs no import here — the generator adds it for every template
// that references it.)
package views

// shellData is the chrome of the backend frame. The frame carries no
// request state of its own (the identity-dependent bits render inside the
// pages), so the brand name and the navigation's addresses — resolved by
// route name when the partition assembles — are the moving parts.
type shellData struct {
	AppName      string
	DashboardURL string
	PostsURL     string
	SystemURL    string
	HomeURL      string
}

templ shell(nav shellData, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				:root { font-family: system-ui, sans-serif; color: #e5e7eb; background: #111827; }
				body { margin: 0; display: flex; min-height: 100vh; }
				a { color: #93c5fd; }
				aside { width: 14rem; flex-shrink: 0; background: #0b1220; color: #cbd5e1; padding: 1.2rem 1rem; box-sizing: border-box; }
				.brand { display: block; font-weight: 700; color: #f8fafc; margin-bottom: 1.5rem; }
				aside nav { display: flex; flex-direction: column; gap: 0.4rem; }
				aside nav a { text-decoration: none; color: #cbd5e1; padding: 0.35rem 0.6rem; border-radius: 0.375rem; }
				aside nav a.active { background: #1d4ed8; color: #ffffff; }
				.side-note { margin-top: auto; font-size: 0.8rem; color: #64748b; padding-top: 1.5rem; }
				main { flex: 1; padding: 1.5rem 2rem; }
				main h1 { color: #f8fafc; }
				main h1 + p.actions { margin-top: -0.6rem; }
				footer { color: #64748b; padding-top: 1.5rem; font-size: 0.85rem; }
				table { border-collapse: collapse; width: 100%; margin-top: 0.8rem; }
				th, td { border: 1px solid #1f2937; padding: 0.45rem 0.6rem; text-align: left; }
				th { background: #0b1220; color: #cbd5e1; }
				td form { display: inline; }
				td form button { padding: 0.15rem 0.6rem; font: inherit; cursor: pointer; background: none; border: 1px solid #374151; color: #f87171; border-radius: 0.25rem; }
				button, .button { padding: 0.3rem 0.9rem; font: inherit; cursor: pointer; }
				.button { display: inline-block; background: #1d4ed8; color: #ffffff !important; text-decoration: none; border: none; border-radius: 0.25rem; }
				div.form-group { margin: 0.9rem 0; }
				div.form-group label { display: block; margin-bottom: 0.25rem; color: #cbd5e1; }
				.form-control { display: block; width: 100%; max-width: 34rem; padding: 0.35rem; font: inherit; box-sizing: border-box; background: #0b1220; color: #e5e7eb; border: 1px solid #334155; border-radius: 0.25rem; }
				textarea.form-control { max-width: 44rem; min-height: 10rem; }
				div.help-block { color: #f87171; margin-top: 0.25rem; }
				.meta { color: #94a3b8; }
				ul.pagination { display: flex; gap: 0.3rem; list-style: none; padding: 0; margin-top: 1.2rem; }
				ul.pagination li a, ul.pagination li span { display: block; padding: 0.25rem 0.6rem; border: 1px solid #374151; border-radius: 4px; }
				ul.pagination li.active a { background: #1d4ed8; color: #ffffff; }
				ul.pagination li.disabled span { color: #64748b; }
			</style>
		</head>
		<body>
			<aside>
				<span class="brand">{ nav.AppName } · backend</span>
				<nav>
					<a href={ templ.URL(nav.DashboardURL) } class={ templ.KV("active", navActive(ctx, nav.DashboardURL)) }>Dashboard</a>
					<a href={ templ.URL(nav.PostsURL) } class={ templ.KV("active", navActive(ctx, nav.PostsURL)) }>Posts</a>
					<a href={ templ.URL(nav.SystemURL) } class={ templ.KV("active", navActive(ctx, nav.SystemURL)) }>System</a>
					<a href={ templ.URL(nav.HomeURL) }>View site</a>
				</nav>
				<p class="side-note">backend partition — module /backend, guarded by the admin role</p>
			</aside>
			<main>
				@content
				<footer>{ nav.AppName } — backend partition · goyii advanced demo</footer>
			</main>
		</body>
	</html>
}

templ dashboardPage(d DashboardData) {
	<h1>Dashboard</h1>
	<p>Signed in as <strong>{ d.User }</strong> — the admin role let you past the module guard.</p>
	<p>
		This is the backend application of the advanced template: one /backend module behind a
		module-wide access rule (unauthenticated visitors are pointed at the login page, accounts
		without the admin role are refused), framed by this dark layout.
	</p>
}

// postIndexPage is the management listing: every post (drafts included),
// each row with its actions. The delete button posts a small form so the
// CSRF token rides along; the title links to the edit form.
templ postIndexPage(d PostIndexData) {
	<h1>Posts</h1>
	<p class="actions">
		<a class="button" href={ templ.URL(d.CreateURL) }>New post</a>
	</p>
	if len(d.Rows) == 0 {
		<p class="meta">No posts yet — create the first one.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th>Title</th>
					<th>Status</th>
					<th>Author</th>
					<th>Updated</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range d.Rows {
					<tr>
						<td>{ row.ID }</td>
						<td><a href={ templ.URL(row.EditURL) }>{ row.Title }</a></td>
						<td>{ row.Status }</td>
						<td>{ row.Author }</td>
						<td>{ row.Updated }</td>
						<td>
							if row.ViewURL != "" {
								<a href={ templ.URL(row.ViewURL) }>View</a>
							}
							<a href={ templ.URL(row.EditURL) }>Edit</a>
							<form method="post" action={ templ.URL(row.DeleteURL) }>
								<input type="hidden" name="_csrf" value={ d.CSRF }/>
								<button type="submit">Delete</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// postFormPage frames the ActiveForm the controller rendered — on a 422 the
// widget already carries the messages and the refilled values. The permalink
// line rides along on the edit page only: the row's address on the backend's
// own domain, the partition's one absolute link.
templ postFormPage(d PostFormData) {
	<h1>{ d.Heading }</h1>
	@d.Form
	if d.PermalinkURL != "" {
		<p class="meta">Permalink: <a href={ templ.URL(d.PermalinkURL) }>{ d.PermalinkURL }</a></p>
	}
	<p style="margin-top: 0.8rem;">
		<a href={ templ.URL(d.CancelURL) }>Cancel</a>
	</p>
}

// systemUserPage is the nested system submodule's account listing: the rows
// the DataProvider fetched for the current page, the totals line and the
// LinkPager bar. The account row shows login names only — password hashes
// never reach a page.
templ systemUserPage(d SystemUserData) {
	<h1>Users</h1>
	<p class="meta">
		{ d.TotalCount } accounts · page { d.Page } of { d.PageCount }
		— module /backend/system, convention-routed
	</p>
	if len(d.Rows) == 0 {
		<p class="meta">No accounts yet.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th>Username</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range d.Rows {
					<tr>
						<td>{ row.ID }</td>
						<td>{ row.Username }</td>
					</tr>
				}
			</tbody>
		</table>
		@d.Pager
	}
}
