// The templ components of the browser pages. Labels resolve through
// i18n.T at render time — the request context carries both the display
// language and the embedded message source, so one template serves every
// language.
package main

import (
	"github.com/goyii2/framework/i18n"
)

templ appShell(nav navData, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ nav.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				:root { font-family: system-ui, sans-serif; color: #222; background: #fafafa; }
				body { margin: 0; }
				a { color: #1a5fb4; }
				header { display: flex; align-items: center; gap: 1.5rem; padding: 0.6rem 1.2rem; background: #1f2937; color: #fff; flex-wrap: wrap; }
				header a { color: #e5e7eb; text-decoration: none; }
				.brand { font-weight: 700; color: #fff; }
				header ul { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
				header .active { color: #93c5fd; font-weight: 600; }
				.session { margin-left: auto; display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
				.session .langs a { margin-left: 0.4rem; }
				.session .langs .current { color: #fbbf24; font-weight: 600; }
				main { max-width: 60rem; margin: 1.5rem auto; padding: 0 1rem; }
				footer { text-align: center; color: #9ca3af; padding: 1rem; font-size: 0.85rem; }
				table { border-collapse: collapse; width: 100%; background: #fff; }
				th, td { border: 1px solid #e5e7eb; padding: 0.45rem 0.6rem; text-align: left; }
				th { background: #f3f4f6; }
				tr:nth-child(even) td { background: #f9fafb; }
				.meta { color: #6b7280; }
				.error { color: #b91c1c; }
				form label { display: block; margin: 0.8rem 0; font-weight: 600; }
				form label span.error { display: block; font-weight: 400; }
				form.search { display: flex; gap: 0.4rem; margin: 0.8rem 0; }
				form.search input[type=search] { padding: 0.35rem; font: inherit; box-sizing: border-box; width: 16rem; max-width: 60vw; }
				input[type=text], input[type=password], select, textarea { display: block; width: 100%; max-width: 30rem; margin-top: 0.25rem; padding: 0.35rem; font: inherit; box-sizing: border-box; }
				textarea { max-width: 40rem; }
				button { padding: 0.35rem 1rem; font: inherit; cursor: pointer; }
				.button { display: inline-block; padding: 0.35rem 0.9rem; background: #1a5fb4; color: #fff !important; border-radius: 4px; text-decoration: none; }
				ol.breadcrumbs { padding: 0; list-style: none; color: #6b7280; }
				ol.breadcrumbs li { display: inline; }
				ol.breadcrumbs li + li::before { content: " / "; }
				ul.pagination { display: flex; gap: 0.3rem; list-style: none; padding: 0; }
				ul.pagination li a, ul.pagination li span { display: block; padding: 0.25rem 0.6rem; border: 1px solid #d1d5db; border-radius: 4px; }
				ul.pagination li.active a { background: #1a5fb4; color: #fff; }
				ul.pagination li.disabled span { color: #9ca3af; }
				.actions form { display: inline; }
			</style>
		</head>
		<body>
			<header>
				<span class="brand">{ nav.AppName }</span>
				@nav.Menu
				<div class="session">
					if nav.User != "" {
						<span>{ nav.User }</span>
						<form method="post" action={ templ.URL(nav.LogoutURL) }>
							<input type="hidden" name="_csrf" value={ nav.CSRF }/>
							<button type="submit">{ i18n.T(ctx, "app", "Logout", nil) }</button>
						</form>
					} else {
						<a href={ templ.URL(nav.LoginURL) }>{ i18n.T(ctx, "app", "Login", nil) }</a>
					}
					<span class="langs">
						for _, l := range nav.Langs {
							<a href={ templ.URL(l.URL) } class={ templ.KV("current", l.Current) }>{ l.Label }</a>
						}
					</span>
				</div>
			</header>
			<main>
				@content
			</main>
			<footer>{ nav.AppName } — goyii basic demo</footer>
		</body>
	</html>
}

templ homePage(d homeData) {
	<h1>{ i18n.T(ctx, "app", "Welcome to the goyii basic application", nil) }</h1>
	<p>
		{ i18n.T(ctx, "app", "This application walks the whole framework stack in a browser: session login, RBAC-differentiated navigation, translated interface and validation messages, a paginated and sortable post list, detail views, validated edit forms, automatic timestamps and the mailer.", nil) }
	</p>
	<p>
		<a class="button" href={ templ.URL(d.PostsURL) }>{ i18n.T(ctx, "app", "Browse posts", nil) }</a>
		if !d.SignedIn {
			<a href={ templ.URL(d.LoginURL) }>{ i18n.T(ctx, "app", "Sign in to manage posts", nil) }</a>
		}
	</p>
	<form method="post" action={ templ.URL(d.NotifyURL) }>
		<input type="hidden" name="_csrf" value={ d.CSRF }/>
		<button type="submit">{ i18n.T(ctx, "app", "Send a test email", nil) }</button>
	</form>
}

templ loginPage(d loginData) {
	<h1>{ i18n.T(ctx, "app", "Login", nil) }</h1>
	if d.Error != "" {
		<p class="error">{ d.Error }</p>
	}
	if len(d.Errors) > 0 {
		<p class="error">{ i18n.T(ctx, "app", "Fix the errors below and try again.", nil) }</p>
	}
	<form method="post" action={ templ.URL(d.Action) }>
		<input type="hidden" name="_csrf" value={ d.CSRF }/>
		<label>
			{ i18n.T(ctx, "app", "Username", nil) }
			<input type="text" name="username" value={ d.Username }/>
			if msg := fieldErrors(d.Errors, "username"); msg != "" {
				<span class="error">{ msg }</span>
			}
		</label>
		<label>
			{ i18n.T(ctx, "app", "Password", nil) }
			<input type="password" name="password"/>
			if msg := fieldErrors(d.Errors, "password"); msg != "" {
				<span class="error">{ msg }</span>
			}
		</label>
		<button type="submit">{ i18n.T(ctx, "app", "Sign in", nil) }</button>
	</form>
	<p class="meta">admin / admin123 — editor / editor123 — demo / demo123</p>
}

templ postsPage(d postsListData) {
	<h1>{ i18n.T(ctx, "app", "Posts", nil) }</h1>
	<form class="search" method="get" action={ templ.URL(d.SearchAction) }>
		<input type="search" name="q" value={ d.Query } placeholder={ i18n.T(ctx, "app", "Search posts", nil) }/>
		<button type="submit">{ i18n.T(ctx, "app", "Search", nil) }</button>
	</form>
	<p class="meta">
		{ i18n.T(ctx, "app", "Total {n} posts", map[string]any{"n": d.Total}) }
		if d.CanCreate {
			<a class="button" href={ templ.URL(d.CreateURL) }>{ i18n.T(ctx, "app", "New post", nil) }</a>
		}
	</p>
	if len(d.Rows) == 0 {
		if d.Query != "" {
			<p>{ i18n.T(ctx, "app", "No posts match your search.", nil) }</p>
		} else {
			<p>{ i18n.T(ctx, "app", "No posts yet.", nil) }</p>
		}
	} else {
		<table>
			<thead>
				<tr>
					<th><a href={ templ.URL(d.SortID.URL) }>{ i18n.T(ctx, "app", "ID", nil) }{ d.SortID.Arrow }</a></th>
					<th><a href={ templ.URL(d.SortTitle.URL) }>{ i18n.T(ctx, "app", "Title", nil) }{ d.SortTitle.Arrow }</a></th>
					<th><a href={ templ.URL(d.SortStatus.URL) }>{ i18n.T(ctx, "app", "Status", nil) }{ d.SortStatus.Arrow }</a></th>
					<th>{ i18n.T(ctx, "app", "Author", nil) }</th>
					<th><a href={ templ.URL(d.SortCreated.URL) }>{ i18n.T(ctx, "app", "Created at", nil) }{ d.SortCreated.Arrow }</a></th>
					<th>{ i18n.T(ctx, "app", "Actions", nil) }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range d.Rows {
					<tr>
						<td>{ row.ID }</td>
						<td><a href={ templ.URL(row.ViewURL) }>{ row.Title }</a></td>
						<td>{ i18n.T(ctx, "app", row.Status, nil) }</td>
						<td>{ row.Author }</td>
						<td>{ row.CreatedAt }</td>
						<td>
							if row.ShowEdit {
								<a href={ templ.URL(row.EditURL) }>{ i18n.T(ctx, "app", "Edit", nil) }</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		@d.Pager
	}
}

templ postShowPage(d postShowData) {
	@d.Breadcrumbs
	<h1>{ d.Title }</h1>
	@d.Detail
	<p class="actions">
		<a class="button" href={ templ.URL(d.BackURL) }>{ i18n.T(ctx, "app", "Back to list", nil) }</a>
		if d.CanUpdate {
			<a href={ templ.URL(d.EditURL) }>{ i18n.T(ctx, "app", "Edit", nil) }</a>
		}
		if d.CanDelete {
			<form method="post" action={ templ.URL(d.DeleteURL) }>
				<input type="hidden" name="_csrf" value={ d.CSRF }/>
				<button type="submit">{ i18n.T(ctx, "app", "Delete", nil) }</button>
			</form>
		}
	</p>
}

templ postFormPage(d postFormData) {
	@d.Breadcrumbs
	<h1>{ d.Heading }</h1>
	if len(d.Errors) > 0 {
		<p class="error">{ i18n.T(ctx, "app", "Fix the errors below and try again.", nil) }</p>
	}
	<form method="post" action={ templ.URL(d.Action) }>
		<input type="hidden" name="_csrf" value={ d.CSRF }/>
		<label>
			{ i18n.T(ctx, "app", "Title", nil) }
			<input type="text" name="title" value={ d.Title }/>
			if msg := fieldErrors(d.Errors, "title"); msg != "" {
				<span class="error">{ msg }</span>
			}
		</label>
		<label>
			{ i18n.T(ctx, "app", "Status", nil) }
			<select name="status">
				<option value="draft" selected?={ d.Status == "draft" }>{ i18n.T(ctx, "app", "draft", nil) }</option>
				<option value="published" selected?={ d.Status == "published" }>{ i18n.T(ctx, "app", "published", nil) }</option>
			</select>
			if msg := fieldErrors(d.Errors, "status"); msg != "" {
				<span class="error">{ msg }</span>
			}
		</label>
		<label>
			{ i18n.T(ctx, "app", "Body", nil) }
			<textarea name="body" rows="10">{ d.Body }</textarea>
			if msg := fieldErrors(d.Errors, "body"); msg != "" {
				<span class="error">{ msg }</span>
			}
		</label>
		<button type="submit">{ i18n.T(ctx, "app", "Save", nil) }</button>
		<a href={ templ.URL(d.CancelURL) }>{ i18n.T(ctx, "app", "Cancel", nil) }</a>
	</form>
}

templ notifyPage(d notifyData) {
	<h1>{ i18n.T(ctx, "app", "Mail sent", nil) }</h1>
	<p>{ i18n.T(ctx, "app", "The message was handed to the configured mailer. The log driver records it in the application log; set mail.driver to smtp in config/app.yaml for real delivery.", nil) }</p>
	<p class="meta">{ d.Recipient }</p>
	<p><a class="button" href={ templ.URL(d.HomeURL) }>{ i18n.T(ctx, "app", "Home", nil) }</a></p>
}

// errorPageData is the unified error payload reshaped for the template; the
// status text is precomputed so the template interpolates strings only.
type errorPageData struct {
	Heading string
	Message string
}

templ errorPage(d errorPageData) {
	<h1>{ d.Heading }</h1>
	<p>{ i18n.T(ctx, "app", d.Message, nil) }</p>
	<p><a href="/">{ i18n.T(ctx, "app", "Home", nil) }</a></p>
}
