// find{{.Model}} loads the record addressed by the id path parameter; a
// missing or unparsable id answers 404.
func find{{.Model}}(c *web.Context) (*{{.Model}}, error) {
	id, err := c.ParamInt64("{{.PK.Column}}")
	if err != nil {
		return nil, web.NotFound("{{.ID}} not found")
	}
	{{.ModelVar}}, err := ar.FindByID[{{.Model}}](c.Context(), id)
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return nil, web.NotFound("{{.ID}} not found")
	}
	if err != nil {
		return nil, err
	}
	return {{.ModelVar}}, nil
}
