}

// ActionSave receives the form of both routes and binds it straight into
// the record: without the id path parameter it binds a fresh record under
// the insert scenario; with one it fetches the row first and overwrites it
// under the update scenario, so fields the form left out keep their stored
// values instead of being blanked. A rejected submission re-renders the
// form under 422, the messages and the entered values echoed back.
func ({{.Receiver}} *{{.Controller}}) ActionSave(c *web.Context) error {
	{{.ModelVar}} := ar.New[{{.Model}}](c.Context()).New()
	scenario := validators.ScenarioInsert
	if c.Param("{{.PK.Column}}") != "" {
		var err error
		{{.ModelVar}}, err = find{{.Model}}(c)
		if err != nil {
			return err
		}
		scenario = validators.ScenarioUpdate
	}
	if errs := c.LoadForm({{.ModelVar}}, scenario); errs != nil {
		return render{{.Model}}Form(c, {{.ModelVar}}, http.StatusUnprocessableEntity, errs)
	}
	if err := {{.ModelVar}}.Save(); err != nil {
		var verrs *validators.Errors
		if errors.As(err, &verrs) {
			return render{{.Model}}Form(c, {{.ModelVar}}, http.StatusUnprocessableEntity, verrs)
		}
		return err
	}
	return c.Redirect(http.StatusFound, url.To("{{.ID}}/list", nil))
}

