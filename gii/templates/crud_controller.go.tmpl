	if fields := input.apply({{.ModelVar}}); len(fields) > 0 {
		return render{{.Model}}Form(c, {{.ModelVar}}, http.StatusUnprocessableEntity, fields)
	}
	if err := {{.ModelVar}}.Save(); err != nil {
		var verrs *validators.Errors
		if errors.As(err, &verrs) {
			return render{{.Model}}Form(c, {{.ModelVar}}, http.StatusUnprocessableEntity, verrs.Fields)
		}
		return err
	}
	return c.Redirect(http.StatusFound, url.To("{{.ID}}/list", nil))
}

