{{- if .UsesStringPtr}}

// stringPtr maps an empty submitted value to nil — the column stays NULL —
// and any other value to a pointer.
func stringPtr(v string) *string {
	if v == "" {
		return nil
	}
	return &v
}
{{- end}}
{{- if .UsesBoolPtr}}

// boolPtr lifts a checkbox verdict into a nullable column.
func boolPtr(v bool) *bool { return &v }
{{- end}}
{{- if .UsesCheckbox}}

// checkboxValue renders a bool for the echo map: empty when off, so the
// ActiveForm checkbox renders unchecked.
func checkboxValue(on bool) string {
	if on {
		return "1"
	}
	return ""
}
{{- end}}
{{- if .UsesTimeHelpers}}

// timeValue renders a time in the form's datetime-local format; nil and
// zero times render empty.
func timeValue(t *time.Time) string {
	if t == nil || t.IsZero() {
		return ""
	}
	return t.Format(formTimeLayout)
}
