	grid := view.GridView{
		Columns:   {{.ModelVar}}Columns,
		ItemCount: len(res.Items),
		Item:      func(i int) any { return res.Items[i] },
		Sort:      query.Get("sort"),
		SortURL: func(sortValue string) string {
			q := url.P{"sort": sortValue}
			if page := query.Get("page"); page != "" {
