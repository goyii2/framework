// render{{.Model}}Form renders the shared create/edit form. Editing picks
// the heading and targets the record's update route; status is 200 for a
// fresh form and 422 when a rejected submission re-renders with its
// messages. The refill values come from form.Values over the record the
// action holds — a prefilled row or a rejected submission — and the errors
// arrive straight from the binding and save chain.
func render{{.Model}}Form(c *web.Context, {{.ModelVar}} *{{.Model}}, status int, verrs *validators.Errors) error {
	heading := "New {{.ModelVar}}"
	action := url.To("{{.ID}}/save", nil)
	deleteURL := ""
	if {{.PK.ZeroCheck}} {
		heading = "Edit {{.ModelVar}}"
		action = url.To("{{.ID}}/update", url.P{"{{.PK.Column}}": {{.PK.ValueExpr}}})
		deleteURL = url.To("{{.ID}}/delete", url.P{"{{.PK.Column}}": {{.PK.ValueExpr}}})
	}
	formHTML := view.ActiveForm{
		Action: action,
		Fields: {{.ModelVar}}FormFields,
		Errors: verrs,
		Values: form.Values({{.ModelVar}}),
		CSRF:   c.CsrfToken(),
	}.Render()
	return c.RenderStatus(status, "{{.ID}}/form", {{.ModelVar}}FormData{
		Heading:   heading,
		Form:      formHTML,
		CancelURL: url.To("{{.ID}}/list", nil),
		DeleteURL: deleteURL,
		CSRF:      c.CsrfToken(),
	})
