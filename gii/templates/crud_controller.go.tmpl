// ActionList renders the listing: the filter struct reads the query string
// through the form whitelist, the provider pushes the pagination and the
// whitelisted sort down to SQL, and the GridView and LinkPager widgets
// render the result with the filter values kept around in every link.
func ({{.Receiver}} *{{.Controller}}) ActionList(c *web.Context) error {
	params, err := dataprovider.FromRequest(c.Request(), sortable{{.Model}}Fields...)
	if err != nil {
		return web.BadRequest(err.Error())
	}
	// The filter row reads through the form whitelist — only tagged fields
	// assign, a query key the struct did not declare is ignored — and a
	// value that does not parse into its field answers 400 instead of being
	// silently dropped.
	var filters {{.ModelVar}}Filters
	if errs := form.BindQuery(c.Request(), &filters); errs != nil {
		return web.BadRequest(errs.Error())
	}
	res, err := dataprovider.ActiveDataProvider[{{.Model}}]{
		Query:        filters.Apply(ar.New[{{.Model}}](c.Context())),
		Params:       params,
		DefaultOrder: []dataprovider.Sort{ {Column: "{{.PK.Column}}", Desc: true} },
	}.Prepare()
	if err != nil {
		return err
	}

	// keep returns the query-string parameters that must survive a sort
	// toggle or a pager click: the filter values the struct carries,
	// derived from its form tags instead of a hand-copied key list — a
	// filter field added later rides along automatically.
	filterValues := form.Values(&filters)
	keep := func(p url.P) url.P {
		for name, value := range filterValues {
			if value != "" {
				p[name] = value
			}
		}
		return p
	}
	// The sort links keep the current page around; the pager keeps the
	// active sort.
	query := c.Request().URL.Query()
	grid := view.GridView{
		Columns:   {{.ModelVar}}Columns,
		ItemCount: len(res.Items),
		Item:      func(i int) any { return res.Items[i] },
		Sort:      query.Get("sort"),
		SortURL: func(sortValue string) string {
			q := url.P{"sort": sortValue}
			if page := query.Get("page"); page != "" {
				q["page"] = page
			}
			return url.To("{{.ID}}/list", keep(q))
		},
{{- if .FilterInputs}}
		FilterValues: view.QueryValues(c.Request(),{{range .FilterInputs}} "{{.}}",{{end}}),
{{- end}}
	}.Render()
	pager := view.LinkPager{
		Pagination: res.Pagination(),
		URL: func(page int) string {
			q := url.P{"page": strconv.Itoa(page)}
			if sort := query.Get("sort"); sort != "" {
				q["sort"] = sort
			}
			return url.To("{{.ID}}/list", keep(q))
		},
	}.Render()
	return c.Render("{{.ID}}/list", {{.ModelVar}}ListData{
		Grid:   grid,
		Pager:  pager,
		Total:  res.TotalCount,
		NewURL: url.To("{{.ID}}/new", nil),
	})
}

